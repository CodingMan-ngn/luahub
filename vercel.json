{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/router.js?route=$1" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/keys", "destination": "/frontend/keys.html" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/favicon.svg", "destination": "/frontend/favicon.svg" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}