{
  "version": 2,
  "builds": [
    { "src": "frontend/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/auth/boosty-callback", "dest": "/api/auth/boosty-callback.js" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/scripts", "dest": "/api/scripts.js" },
    { "src": "/api/members", "dest": "/api/members.js" },
    { "src": "/api/keys", "dest": "/api/keys.js" },
    { "src": "/api/profile", "dest": "/api/profile.js" },
    { "src": "/api/loader/(.*)", "dest": "/api/loader/[slug].js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/favicon.svg", "dest": "/frontend/favicon.svg" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/dashboard", "dest": "/frontend/dashboard.html" },
    { "src": "/key-system/success", "dest": "/frontend/key-system-success.html" },
    { "src": "/key-system", "dest": "/frontend/key-system.html" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}