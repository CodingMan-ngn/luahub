{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/scripts", "destination": "/api/scripts.js" },
    { "source": "/api/paste", "destination": "/api/paste.js" },
    { "source": "/api/profile", "destination": "/api/profile.js" },
    { "source": "/api/obfuscate", "destination": "/api/obfuscate.js" },
    { "source": "/api/keys", "destination": "/api/keys.js" },
    { "source": "/api/loader", "destination": "/api/loader.js" },
    { "source": "/favicon.svg", "destination": "/frontend/favicon.svg" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}